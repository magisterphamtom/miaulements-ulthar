<section class="tab mu-onglet {{tabs.fiche.cssClass}}" data-group="primary" data-tab="fiche">
  <span class="mu-zoom-info"></span>
  <div class="mu-page" data-tooltip-direction="UP">
    <img class="mu-fond" src="{{fiche.image}}" alt="">

    <input class="mu-champ mu-texte" style="{{fiche.surnom}}" type="text" name="name" value="{{actor.name}}" placeholder="Surnom">
    <select class="mu-champ mu-texte" style="{{fiche.race}}" name="system.race">
      <option value="">—</option>
      {{#each races}}<option value="{{cle}}" {{#if selected}}selected{{/if}}>{{label}}</option>{{/each}}
    </select>
    <textarea class="mu-champ mu-texte mu-petit" style="{{fiche.description}}" name="system.description" placeholder="Apparence du Chat">{{system.description}}</textarea>

    {{#each attributs}}
    <div class="mu-attr" style="{{position}}">
      <button type="button" class="mu-attr-jet" data-action="jetAttribut" data-attribut="{{cle}}" data-tooltip="{{label}} {{value}} % — {{aide}} Clic : jet (Maj : jet rapide).">{{value}}</button>
      {{#if peutMonter}}<button type="button" class="mu-attr-monter" data-action="monterAttribut" data-attribut="{{cle}}" title="Toutes les cases sont cochées : monter l'attribut (+1D10)">⬆</button>{{/if}}
    </div>
    {{#each casesPos}}
    <button type="button" class="mu-case-echec {{#if cochee}}cochee{{/if}}" style="{{style}}" data-action="cocher" data-attribut="{{../cle}}" data-index="{{index}}" data-tooltip="Case d'échec de {{../label}} : cochée à chaque échec ; les six cochées, l'attribut monte de 1D10."></button>
    {{/each}}
    {{/each}}

    <div class="mu-rond" style="{{fiche.pv}}" data-tooltip="Santé : Physique + Agilité, voir la table."><input type="number" name="system.pv.value" value="{{system.pv.value}}"><span class="mu-max">/ {{system.pv.max}}</span></div>
    <div class="mu-rond" style="{{fiche.vies}}" data-tooltip="Vies de Chat : 3 en temps normal."><input type="number" name="system.vies.value" value="{{system.vies.value}}"><span class="mu-max">/ {{system.vies.max}}</span></div>
    <div class="mu-rond" style="{{fiche.pm}}" data-tooltip="Magie : égale à l'Intelligence."><input type="number" name="system.pm.value" value="{{system.pm.value}}"><span class="mu-max">/ {{system.pm.max}}</span></div>
    <div class="mu-rond" style="{{fiche.pf}}" data-tooltip="Folie : (Perception + Charisme) ÷ 2."><input type="number" name="system.pf.value" value="{{system.pf.value}}"><span class="mu-max">/ {{system.pf.max}}</span></div>
    <div class="mu-rond" style="{{fiche.xp}}" data-tooltip="Expérience"><input type="number" name="system.xp" value="{{system.xp}}"></div>

    <div class="mu-liste" style="{{fiche.innes}}">
      <ul>
        {{#each pouvoirsInnes}}
        <li><a class="mu-nom-pouvoir" data-action="afficherPouvoir" data-item-id="{{id}}" data-tooltip="{{aide}} (clic : montrer à la table)">{{name}}{{#if gratuit}} <small>(0 PM)</small>{{/if}}</a>
          <span class="mu-outils"><a data-action="lancerPouvoir" data-item-id="{{id}}" title="Lancer le pouvoir">✦</a> <a data-action="ouvrirItem" data-item-id="{{id}}" title="Ouvrir">✎</a>
          <a data-action="supprimerItem" data-item-id="{{id}}" title="Supprimer">✕</a></span></li>
        {{/each}}
      </ul>
    </div>
    <div class="mu-liste" style="{{fiche.temporaires}}">
      <ul>
        {{#each pouvoirsTemporaires}}
        <li><a class="mu-nom-pouvoir" data-action="afficherPouvoir" data-item-id="{{id}}" data-tooltip="{{aide}} (clic : montrer à la table)">{{name}}</a>
          <span class="mu-outils"><a data-action="lancerPouvoir" data-item-id="{{id}}" title="Lancer le pouvoir">✦</a> <a data-action="ouvrirItem" data-item-id="{{id}}" title="Ouvrir">✎</a>
          <a data-action="supprimerItem" data-item-id="{{id}}" title="Supprimer">✕</a></span></li>
        {{/each}}
      </ul>
    </div>
  </div>
</section>
