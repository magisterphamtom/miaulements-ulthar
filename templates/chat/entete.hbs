<header class="mu-entete-chat">
  <img class="mu-grand-portrait" src="{{actor.img}}" data-action="editImage" data-edit="img" alt="" title="Changer le portrait">
  <div class="mu-entete-infos">
    <div class="mu-entete-nom">{{actor.name}}</div>
    <div class="mu-entete-race">{{#if raceLabel}}{{raceLabel}}{{else}}Race à choisir (onglet Création){{/if}}{{#if system.handicap}} · {{system.handicap}}{{/if}}</div>
    <div class="mu-entete-jauges">
      <span title="Santé"><i class="fa-solid fa-heart"></i> {{system.pv.value}}<small>/{{system.pv.max}}</small></span>
      <span title="Magie"><i class="fa-solid fa-wand-sparkles"></i> {{system.pm.value}}<small>/{{system.pm.max}}</small></span>
      <span title="Folie" class="{{#if folieBasse}}bas{{/if}}"><i class="fa-solid fa-brain"></i> {{system.pf.value}}<small>/{{system.pf.max}}</small></span>
      <span title="Vies de Chat"><i class="fa-solid fa-paw"></i> {{system.vies.value}}<small>/{{system.vies.max}}</small></span>
      <span title="Expérience"><i class="fa-solid fa-star"></i> {{system.xp}} XP</span>
    </div>
  </div>
</header>
